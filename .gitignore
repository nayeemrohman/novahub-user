# ============================================================
# NovaHub — Git Ignore Rules
# ============================================================

# ---------- Environment secrets ----------
.env
.env.local
.env.*.local
*.env

# ---------- Backups created by scripts ----------
*.backup

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Editor ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- Node (in case of local dev) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ---------- Vercel ----------
.vercel

# ---------- Logs ----------
*.log
logs/